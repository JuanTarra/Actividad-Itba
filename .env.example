# Puerto en el que corre el servidor HTTP
PORT=4000

# Cadena de conexión a MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/ecommerce_api

# Secreto usado para firmar los JSON Web Tokens
JWT_SECRET=cambiame_por_un_secreto_largo_y_random

# Tiempo de expiración de los tokens (formato aceptado por jsonwebtoken)
JWT_EXPIRES_IN=7d

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Origen permitido para CORS (usar * solo en desarrollo)
CORS_ORIGIN=*
